# Application
PROJECT_NAME="SkyOps Flight & Gate Operations"
VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS="*"

# Database (PostgreSQL / Supabase or local SQLite)
DATABASE_URL="sqlite:///./skyops.db"
# For Supabase/PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skyops"

# Authentication
SUPABASE_JWT_SECRET="skyops-jwt-secret-key-for-development"
SUPABASE_URL="https://example.supabase.co"

# Integrations
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_TIMEOUT_SECONDS=8.0
PREDICTOR_SERVICE_URL="http://localhost:8001"

# Operational Buffers
BUFFER_BEFORE_MINUTES=15
BUFFER_AFTER_MINUTES=15
MIN_TURNAROUND_MINUTES=45
